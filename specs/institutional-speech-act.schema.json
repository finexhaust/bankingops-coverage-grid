{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thefazzer/bankingops-coverage-grid/blob/main/specs/institutional-speech-act.schema.json",
  "title": "BOCG institutional speech-act expansion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "literal_speech_act", "institutional_speech_act", "pragmatic_expansion", "obligation_frame", "state_separation_enforced"],
  "properties": {
    "schema": {"const": "kg-institutional-speech-act-expansion.v1"},
    "literal_speech_act": {"$ref": "#/$defs/SpeechAct"},
    "institutional_speech_act": {"$ref": "#/$defs/SpeechAct"},
    "pragmatic_expansion": {
      "type": "object", "additionalProperties": true,
      "required": ["expanded_reading", "basis", "adjudication_status"],
      "properties": {
        "expanded_reading": {"type": "string", "minLength": 12},
        "basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "adjudication_status": {"const": "sme_confirmed"}
      }
    },
    "obligation_frame": {
      "type": "object", "additionalProperties": true,
      "required": ["directive_status", "execution_status", "completion_status", "verification_status"],
      "properties": {
        "directive_status": {"enum": ["directed", "not_observed", "unknown"]},
        "execution_status": {"enum": ["not_observed", "pending", "scheduled", "unknown"]},
        "completion_status": {"enum": ["not_observed", "unknown"]},
        "verification_status": {"enum": ["not_observed", "unknown"]},
        "deadline_constraints": {
          "type": "array",
          "items": {"$ref": "#/$defs/DeadlineConstraint"}
        }
      }
    },
    "state_separation_enforced": {"const": true},
    "expansion_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "TemporalPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "value"],
      "properties": {
        "precision": {"enum": ["instant", "date", "business_date", "month", "year"]},
        "value": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"precision": {"const": "instant"}}}, "then": {"properties": {"value": {"format": "date-time"}}}},
        {"if": {"properties": {"precision": {"enum": ["date", "business_date"]}}}, "then": {"properties": {"value": {"format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}}},
        {"if": {"properties": {"precision": {"const": "month"}}}, "then": {"properties": {"value": {"pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"}}}},
        {"if": {"properties": {"precision": {"const": "year"}}}, "then": {"properties": {"value": {"pattern": "^[0-9]{4}$"}}}}
      ]
    },
    "TemporalValue": {
      "oneOf": [
        {"type": "string", "format": "date-time"},
        {"$ref": "#/$defs/TemporalPoint"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["precision", "start", "end"],
          "properties": {
            "precision": {"const": "interval"},
            "start": {"$ref": "#/$defs/TemporalPoint"},
            "end": {"$ref": "#/$defs/TemporalPoint"}
          }
        }
      ]
    },
    "DeadlineConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadline_type", "reference_time"],
      "properties": {
        "deadline_type": {"enum": ["regulatory", "contractual", "internal_sla", "market_cutoff"]},
        "reference_time": {"$ref": "#/$defs/TemporalValue"},
        "window": {"type": "string"},
        "business_calendar": {"type": "string"},
        "non_business_day_rule": {"enum": ["previous", "following", "modified_following", "none"]}
      }
    },
    "SpeechAct": {
      "type": "object", "additionalProperties": true, "required": ["type"],
      "properties": {"type": {"enum": ["directive", "information_request", "confirmation_request", "commitment", "acknowledgement", "assertion"]}}
    }
  }
}
