{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thefazzer/bankingops-coverage-grid/blob/main/specs/insight-construction.schema.json",
  "title": "BOCG portable insight-construction objects",
  "oneOf": [
    {"$ref": "#/$defs/ObservationAtom"},
    {"$ref": "#/$defs/Trace"},
    {"$ref": "#/$defs/Episode"},
    {"$ref": "#/$defs/TraceHypothesisGroup"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "EvidenceReference": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_id", "lines", "selected_content_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "lines": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2},
        "selected_content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ObservationAtom": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "atom_id", "predicate", "assertion_status", "source_refs"],
      "properties": {
        "kind": {"const": "ObservationAtom"},
        "atom_id": {"type": "string", "minLength": 1},
        "subject_entity_id": {"type": ["string", "null"]},
        "predicate": {"type": "string", "minLength": 1},
        "object_entity_id": {"type": ["string", "null"]},
        "object_literal": {},
        "qualifiers": {"type": "object"},
        "assertion_status": {"$ref": "#/$defs/AssertionStatus"},
        "content_origin": {"$ref": "#/$defs/ContentOrigin"},
        "independent_provenance_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/EvidenceReference"}}
      },
      "allOf": [
        {"not": {"required": ["object_entity_id", "object_literal"], "properties": {"object_entity_id": {"type": "string"}, "object_literal": {"not": {"type": "null"}}}}},
        {"if": {"required": ["content_origin"], "properties": {"content_origin": {"const": "author_supplied"}}}, "then": {"required": ["independent_provenance_weight"]}}
      ]
    },
    "Trace": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "trace_id", "atom_ids", "ordering_model", "causality_asserted"],
      "properties": {
        "kind": {"const": "Trace"},
        "trace_id": {"type": "string", "minLength": 1},
        "atom_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "ordering_model": {"enum": ["partial_order", "total_order", "unordered"]},
        "causality_asserted": {"type": "boolean"}
      }
    },
    "TraceHypothesisGroup": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "group_id", "trace_ids", "single_process_instance_asserted"],
      "properties": {
        "kind": {"const": "TraceHypothesisGroup"},
        "group_id": {"type": "string", "minLength": 1},
        "trace_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "single_process_instance_asserted": {"const": false}
      }
    },
    "Episode": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "episode_id", "atom_ids", "composition_status"],
      "properties": {
        "kind": {"const": "Episode"},
        "episode_id": {"type": "string", "minLength": 1},
        "atom_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "composition_status": {"enum": ["draft", "candidate", "reviewed", "admitted", "qualified", "recomposition_required", "rejected", "withdrawn"]},
        "review_status": {"enum": ["unreviewed", "current", "stale"]},
        "review_history": {"type": "array", "items": {"$ref": "#/$defs/ReviewRecord"}},
        "adjudications": {"type": "array", "items": {"$ref": "#/$defs/AdjudicationRecord"}},
        "rejection": {"$ref": "#/$defs/RejectionDisposition"},
        "open_questions": {"type": "array", "items": {"$ref": "#/$defs/OpenQuestion"}},
        "execution_status": {"$ref": "#/$defs/LifecycleStatus"},
        "completion_status": {"$ref": "#/$defs/LifecycleStatus"},
        "verification_status": {"$ref": "#/$defs/LifecycleStatus"},
        "temporal_anchors": {
          "type": "array",
          "items": {"$ref": "#/$defs/TemporalAnchor"}
        },
        "deadline_constraints": {
          "type": "array",
          "items": {"$ref": "#/$defs/DeadlineConstraint"}
        }
      },
      "allOf": [
        {"if": {"properties": {"composition_status": {"const": "rejected"}}}, "then": {"required": ["rejection"]}}
      ]
    },
    "AssertionStatus": {"enum": ["asserted", "denied", "disputed", "uncertain", "inferred", "withdrawn"]},
    "ContentOrigin": {"enum": ["source_observed", "author_supplied", "machine_inferred", "owner_attested", "sme_attested"]},
    "AdjudicationBasis": {"enum": ["source_evidence", "owner_attestation", "sme_attestation", "owner_attestation_as_assumption", "sme_attestation_as_assumption", "author_supplied_completion", "independent_provenance"]},
    "AdjudicationRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": ["adjudicator_role", "basis"],
      "properties": {
        "adjudicator_role": {"enum": ["owner", "sme", "author", "machine", "independent_reviewer"]},
        "basis": {"$ref": "#/$defs/AdjudicationBasis"},
        "independent_provenance_weight": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "allOf": [
        {"if": {"properties": {"basis": {"enum": ["author_supplied_completion", "independent_provenance"]}}}, "then": {"required": ["independent_provenance_weight"]}}
      ]
    },
    "ReviewRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": ["reviewer_role", "reviewed_at", "review_status"],
      "properties": {
        "reviewer_role": {"enum": ["owner", "sme", "second_reviewer"]},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "review_status": {"enum": ["current", "stale"]}
      }
    },
    "RejectionDisposition": {
      "type": "object",
      "additionalProperties": true,
      "required": ["reason", "attributed_to", "reopenable"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "attributed_to": {"enum": ["owner", "sme", "second_reviewer"]},
        "reopenable": {"const": true}
      }
    },
    "OpenQuestion": {
      "type": "object",
      "additionalProperties": true,
      "required": ["question_type", "question"],
      "properties": {
        "question_type": {"enum": ["evidence_gap", "actor_identity", "causal_link", "outcome", "temporal_bound", "mapping", "other"]},
        "question": {"type": "string", "minLength": 1}
      }
    },
    "LifecycleState": {"enum": ["not_observed", "directed", "pending", "scheduled", "executed", "completed", "verified", "unknown"]},
    "DeadlineReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "citation"],
      "properties": {
        "expression": {"type": "string", "minLength": 1, "description": "Regime clock expression, e.g. T+1 business day or CSA notification time."},
        "citation": {"type": "string", "minLength": 1, "description": "Citation from which the deadline expression derives."}
      }
    },
    "LifecycleStateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"$ref": "#/$defs/LifecycleState"},
        "occurred_at": {"type": "string", "format": "date-time", "description": "Source-grounded timestamp when the transition into this state occurred."},
        "deadline_ref": {"$ref": "#/$defs/DeadlineReference"},
        "calendar_ref": {"type": "string", "minLength": 1, "description": "Business-day calendar identifier used to interpret deadline_ref."}
      }
    },
    "LifecycleStatus": {
      "oneOf": [
        {"$ref": "#/$defs/LifecycleState"},
        {"$ref": "#/$defs/LifecycleStateTransition"}
      ]
    },
    "TemporalAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_type", "timestamp"],
      "properties": {
        "anchor_type": {"enum": ["observed_at", "valid_from", "valid_to", "deadline", "scheduled_at", "executed_at", "completed_at", "verified_at"]},
        "timestamp": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string"},
        "precision": {"enum": ["instant", "date", "business_date", "unknown"]}
      }
    },
    "DeadlineConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadline_type", "reference_time"],
      "properties": {
        "deadline_type": {"enum": ["regulatory", "contractual", "internal_sla", "market_cutoff"]},
        "reference_time": {"type": "string", "format": "date-time"},
        "window": {"type": "string"},
        "business_calendar": {"type": "string"},
        "non_business_day_rule": {"enum": ["previous", "following", "modified_following", "none"]}
      }
    }
  }
}
