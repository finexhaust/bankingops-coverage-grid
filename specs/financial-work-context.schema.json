{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thefazzer/bankingops-coverage-grid/blob/main/specs/financial-work-context.schema.json",
  "title": "BOCG financial-work context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "root_ref",
    "public_definitions_only",
    "institution_instances",
    "method",
    "semantics",
    "sources",
    "snapshots",
    "domains",
    "capabilities",
    "areas",
    "counts",
    "context_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bocg.financial-work-context/v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "PROPOSED"
    },
    "root_ref": {
      "const": "domain:institutional_finance"
    },
    "public_definitions_only": {
      "const": true
    },
    "institution_instances": {
      "const": false
    },
    "method": {
      "type": "object"
    },
    "semantics": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "path",
          "binding_note",
          "source_status",
          "sha256",
          "area_count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "historical_generation",
              "current_generation"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "binding_note": {
            "type": "string",
            "minLength": 1
          },
          "source_status": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "area_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_id",
          "code",
          "label",
          "definition",
          "broader",
          "status"
        ],
        "properties": {
          "reference_id": {
            "type": "string",
            "pattern": "^domain:[a-z_]+$"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "broader": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "const": "PROPOSED"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_id",
          "label",
          "definition",
          "status",
          "ordered_stage",
          "mandatory"
        ],
        "properties": {
          "reference_id": {
            "type": "string",
            "pattern": "^capability:[a-z_]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "PROPOSED"
          },
          "ordered_stage": {
            "const": false
          },
          "mandatory": {
            "const": false
          }
        }
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_id",
          "division_key",
          "labels_by_snapshot",
          "snapshot_bindings",
          "label",
          "domain_links",
          "context_status",
          "current_presence",
          "absence_means_retired"
        ],
        "properties": {
          "reference_id": {
            "type": "string",
            "pattern": "^division:[a-z0-9_]+$"
          },
          "division_key": {
            "type": "string",
            "minLength": 1
          },
          "labels_by_snapshot": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "snapshot_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "snapshot_id",
                "matrix_sha256",
                "source_status"
              ],
              "properties": {
                "snapshot_id": {
                  "type": "string",
                  "minLength": 1
                },
                "matrix_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "source_status": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "domain_links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reference_id",
                "relation",
                "status",
                "basis"
              ],
              "properties": {
                "reference_id": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "const": "skos:broader"
                },
                "status": {
                  "const": "PROPOSED"
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "context_status": {
            "enum": [
              "PROPOSED",
              "PENDING"
            ]
          },
          "current_presence": {
            "enum": [
              "present",
              "historical_only"
            ]
          },
          "absence_means_retired": {
            "const": false
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areas",
        "domains",
        "capabilities",
        "current_areas",
        "historical_only_areas",
        "unplaced_areas"
      ],
      "properties": {
        "areas": {
          "type": "integer",
          "minimum": 0
        },
        "domains": {
          "type": "integer",
          "minimum": 0
        },
        "capabilities": {
          "type": "integer",
          "minimum": 0
        },
        "current_areas": {
          "type": "integer",
          "minimum": 0
        },
        "historical_only_areas": {
          "type": "integer",
          "minimum": 0
        },
        "unplaced_areas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {}
}
